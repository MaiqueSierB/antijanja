# Discord Developer Portal
DISCORD_TOKEN=SEU_TOKEN_DO_BOT
DISCORD_CLIENT_ID=ID_DA_APLICACAO
# Opcional: registra comandos imediatamente em um servidor específico
DISCORD_GUILD_ID=ID_DO_SERVIDOR

# URL pública do site. Em produção, use HTTPS.
PUBLIC_URL=https://seu-dominio.com
PORT=3000

# Opcional: configure um servidor TURN para melhorar conexões em redes restritas.
# Exemplo: TURN_URL=turn:turn.seu-dominio.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Limites e limpeza automática de salas
SESSION_TTL_MINUTES=240
MAX_VIEWERS_PER_SESSION=6
